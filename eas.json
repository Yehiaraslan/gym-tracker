  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://gym.alibondabo.com",
        "EXPO_PUBLIC_GUEST_CODE": "be9d3dbb712dea4e"
